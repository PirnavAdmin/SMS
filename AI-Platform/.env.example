# ============================================================
# Pirnav SMS Autonomous AI Platform - Environment Configuration
# Copy to .env for local development. NEVER commit .env to Git.
# ============================================================

APP_NAME="Pirnav SMS Autonomous AI Platform"
APP_ENV=development
AI_HOST=127.0.0.1
AI_PORT=8100
LOG_LEVEL=INFO

# --- Multi-LLM Intelligence Engine ---
# Supported primary/fallback providers: mock, gemini, openai_compatible
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_REASONING=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Authoritative ERP & Service-to-Service Security ---
# Shared HMAC-SHA256 secret with ASP.NET Core InternalAiBridgeController
AI_CONTEXT_HMAC_SECRET=change-this-local-dev-hmac-secret-key-min-32-chars
AI_CONTEXT_MAX_AGE_SECONDS=120
ERP_BASE_URL=http://127.0.0.1:5151
ERP_SERVICE_TIMEOUT_SECONDS=15.0

# Optional direct JWT verification (must match ASP.NET Core Jwt settings when enabled)
ALLOW_DIRECT_JWT_AUTH=false
JWT_SECRET_KEY=
JWT_ISSUER=SMS_NEW_API
JWT_AUDIENCE=SMS_NEW_Client

# --- Read-Only MySQL Analytical Database (NEVER write/mutate ERP tables) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sms_new_test
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_READONLY=true

# --- Autonomous Agent Budgets ---
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=15
AGENT_MAX_TOKENS=32000
AGENT_TIMEOUT_SECONDS=45.0
AGENT_MAX_PARALLEL_TOOLS=4

# --- Memory, Cache & Vector Store (Local fallbacks enabled when Redis/Qdrant absent) ---
MEMORY_SQLITE_PATH=data/ai_platform.db
MEMORY_TTL_SECONDS=86400
DATA_FRESHNESS_SECONDS=300
REDIS_URL=
CELERY_BROKER_URL=
QDRANT_URL=
RAG_DOCS_DIR=data/rag_docs

# --- Observability ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=pirnav-sms-ai-platform
