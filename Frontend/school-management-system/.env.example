# School Management System (SMS) - Frontend Environment Variables

# The base URL of the ASP.NET Core backend.
# - If left empty or undefined, it defaults to the shared ngrok tunnel address
#   and routes requests via the Vite dev server proxy in development mode.
# - Set this to your local backend address (e.g., http://localhost:5151) 
#   or your personal ngrok URL to test against a custom backend instance.
VITE_API_URL=https://backspace-prowler-bleach.ngrok-free.dev
