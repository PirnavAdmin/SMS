# School Management System (SMS) - Frontend Environment Variables

# The base URL of the ASP.NET Core backend.
# - Used directly in production builds and as a fallback in local dev.
# - Set this to your local backend address (e.g., http://127.0.0.1:5151)
#   or a shared Cloudflare/ngrok tunnel URL (e.g., https://your-tunnel.trycloudflare.com).
VITE_API_URL=https://your-tunnel.trycloudflare.com

# Optional Vite dev-server proxy target override.
# In dev mode, Vite uses local :5151 if reachable, and automatically falls back
# to VITE_BACKEND_TARGET (or VITE_API_URL) when no local backend is running.
VITE_BACKEND_TARGET=https://your-tunnel.trycloudflare.com

# Set to true to force Vite's proxy to always route to VITE_BACKEND_TARGET / VITE_API_URL
# even if a local backend is running on port 5151.
# VITE_FORCE_REMOTE_PROXY=true
